<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Modern Flat Design -->
    <style name="Base.Theme.TrabMOB2" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/hp_primary</item>
        <item name="colorPrimaryVariant">@color/hp_primary_dark</item>
        <item name="colorOnPrimary">@color/hp_text_on_primary</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/hp_secondary</item>
        <item name="colorSecondaryVariant">@color/hp_secondary_dark</item>
        <item name="colorOnSecondary">@color/hp_text_on_secondary</item>
        
        <!-- Background Colors -->
        <item name="android:colorBackground">@color/hp_background</item>
        <item name="colorSurface">@color/hp_surface</item>
        <item name="colorOnSurface">@color/hp_text_primary</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/hp_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Text Appearance -->
        <item name="android:textColorPrimary">@color/hp_text_primary</item>
        <item name="android:textColorSecondary">@color/hp_text_secondary</item>
    </style>

    <style name="Theme.TrabMOB2" parent="Base.Theme.TrabMOB2" />
    
    <!-- Modern Flat Button Styles -->
    <style name="HPButton" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="HPButton.Primary">
        <item name="backgroundTint">@color/hp_primary</item>
        <item name="android:textColor">@color/hp_text_on_primary</item>
    </style>
    
    <style name="HPButton.Secondary">
        <item name="backgroundTint">@color/hp_secondary</item>
        <item name="android:textColor">@color/hp_text_on_secondary</item>
    </style>
    
    <style name="HPButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/hp_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/hp_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Modern EditText Style -->
    <style name="HPEditText" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/hp_primary</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="android:textColorHint">@color/hp_text_secondary</item>
        <item name="hintTextColor">@color/hp_primary</item>
    </style>
    
    <!-- Card Style -->
    <style name="HPCard">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/hp_surface</item>
        <item name="contentPadding">16dp</item>
    </style>
    
    <!-- Text Styles -->
    <style name="HPText" />
    
    <style name="HPText.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hp_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="HPText.Subtitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hp_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="HPText.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/hp_text_primary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    
    <style name="HPText.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/hp_text_secondary</item>
    </style>
</resources>
