<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hp_background"
    tools:context=".StudentsActivity">

    <!-- Header -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@color/hp_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/HPText.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:text="Escolha uma Casa"
        android:textAlignment="center"
        android:textColor="@color/hp_text_on_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Content Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/contentCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/hp_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBackground">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/HPText.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Selecione uma casa de Hogwarts" />

                <!-- House Selection -->
                <RadioGroup
                    android:id="@+id/radioGroupHouses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">

                    <!-- Gryffindor -->
                    <RadioButton
                        android:id="@+id/radioGryffindor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@color/hp_surface_variant"
                        android:buttonTint="@color/gryffindor_primary"
                        android:elevation="2dp"
                        android:padding="16dp"
                        android:text="Gryffindor"
                        android:textColor="@color/hp_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Slytherin -->
                    <RadioButton
                        android:id="@+id/radioSlytherin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@color/hp_surface_variant"
                        android:buttonTint="@color/slytherin_primary"
                        android:elevation="2dp"
                        android:padding="16dp"
                        android:text="Slytherin"
                        android:textColor="@color/hp_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Ravenclaw -->
                    <RadioButton
                        android:id="@+id/radioRavenclaw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@color/hp_surface_variant"
                        android:buttonTint="@color/ravenclaw_primary"
                        android:elevation="2dp"
                        android:padding="16dp"
                        android:text="Ravenclaw"
                        android:textColor="@color/hp_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Hufflepuff -->
                    <RadioButton
                        android:id="@+id/radioHufflepuff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@color/hp_surface_variant"
                        android:buttonTint="@color/hufflepuff_primary"
                        android:elevation="2dp"
                        android:padding="16dp"
                        android:text="Hufflepuff"
                        android:textColor="@color/hp_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </RadioGroup>

                <Button
                    android:id="@+id/btnGoStudents"
                    style="@style/HPButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Ver Estudantes" />

                <Button
                    android:id="@+id/btnGoMain"
                    style="@style/HPButton.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voltar" />

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
